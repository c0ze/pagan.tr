  },
  "devDependencies": {
    "@rescript/react": "^0.15.0",
    "@rescript/runtime": "^12.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "rescript": "^12.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  }
}
